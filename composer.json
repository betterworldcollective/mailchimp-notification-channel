{
    "name": "betterworld/mailchimp-notification-channel",
    "version": "0.1.2",
    "description": "Custom Mailchimp Channel for Laravel Notification",
    "homepage": "https://github.com/betterworldcollective/mailchimp-notification-channel",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristher Louis Vidal",
            "email": "kristher@betterworld.org",
            "homepage": "https://github.com/kristher1619",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/notifications": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "mailchimp/transactional": "^1.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\Mailchimp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\Mailchimp\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.clover"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\Mailchimp\\MailchimpServiceProvider"
            ]
        }
    }
}
